# ==========================================
# MB BUDDY BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Môi trường chạy (production / development)
NODE_ENV=production

# Cổng HTTP Server (Render sẽ tự động cung cấp biến PORT này)
PORT=3000

# Cổng MQTT TCP (mặc định 1883)
MQTT_PORT=1883

# Thư mục lưu database SQLite (Tùy chọn: chỉ cần khi gắn Render Disk)
# DATA_DIR=/app/data
